+#[test]
+fn display_with_names_the_words_and_keeps_the_glyphs() {
+    let german = |word: KeyWord| match word {
+        KeyWord::Ctrl => Some("Strg".to_owned()),
+        KeyWord::Shift => Some("Umschalt".to_owned()),
+        KeyWord::Key(Key::Delete) => Some("Entf".to_owned()),
+        KeyWord::Key(Key::Space) => Some("Leertaste".to_owned()),
+        _ => None,
+    };
+    assert_eq!(chord("Cmd+Shift+S").display_with(Platform::Windows, &german), "Strg+Umschalt+S");
+    assert_eq!(chord("Ctrl+Alt+Delete").display_with(Platform::Linux, &german), "Strg+Alt+Entf", "no name: the English word");
+    assert_eq!(chord("Ctrl+Tab").display_with(Platform::Windows, &german), "Strg+Tab");
+    assert_eq!(Trigger::parse("Delete Delete").unwrap().display_with(Platform::Windows, &german), "Entf Entf");
+    // macOS glyphs read the same in every language; a key written as a word is still named.
+    assert_eq!(chord("Cmd+Shift+Delete").display_with(Platform::Mac, &german), "⇧⌘⌦");
+    assert_eq!(chord("Ctrl+Space").display_with(Platform::Mac, &german), "⌃Leertaste");
+    assert_eq!(KeyWord::Ctrl.english(), "Ctrl");
+    assert_eq!(KeyWord::Key(Key::PageUp).english(), "Page Up", "the name display writes");
+    // With no names of the app's own, the text is display's, for every key and modifier set.
+    for &key in Key::ALL {
+        for bits in 0..16u8 {
+            let c = Chord::new(mods(bits & 1 != 0, bits & 2 != 0, bits & 4 != 0, bits & 8 != 0), key);
+            for p in [Platform::Mac, Platform::Windows, Platform::Linux] {
+                assert_eq!(c.display_with(p, &|_| None), c.display(p), "{c} on {p:?}");
+            }
+        }
+    }
+}
