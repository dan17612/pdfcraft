+/// The shortcut column in the app's words (`key_names`), shown and read out alike: German
+/// `Strg+Umschalt+S` and `Entf`. Words without a name of the app's stay English, the Mac glyphs
+/// stay, and without the hook the column is as before.
+#[test]
+fn the_shortcut_column_takes_the_apps_key_names() {
+    use egui::os::OperatingSystem as Os;
+    fn german(word: KeyWord) -> Option<String> {
+        let name = match word {
+            KeyWord::Ctrl => "Strg",
+            KeyWord::Shift => "Umschalt",
+            KeyWord::Key(craft_keymap::Key::Delete) => "Entf",
+            _ => return None,
+        };
+        Some(name.to_owned())
+    }
+    fn shortcuts() -> MenuBar {
+        let rows = [
+            ("file.save_as", "Save As…", "Cmd+Shift+S"),
+            ("edit.delete", "Delete", "Delete"),
+            ("view.next_tab", "Next Tab", "Ctrl+Tab"),
+            ("view.tools", "Tools Panel", "Shift+F4"),
+        ];
+        let items: Vec<Node> = rows.into_iter().map(|(id, label, keys)| item(id, label).shortcut(chord(keys)).into()).collect();
+        MenuBar { menus: vec![Menu::new("Edit", items).role(MenuRole::Edit)], documents: Vec::new() }
+    }
+    let de: Option<fn(KeyWord) -> Option<String>> = Some(german);
+    for (target, os, names, shown) in [
+        (Target::Linux, Os::Nix, de, ["Strg+Umschalt+S", "Entf", "Strg+Tab", "Umschalt+F4"]),
+        (Target::Web, Os::Windows, de, ["Strg+Umschalt+S", "Entf", "Strg+Tab", "Umschalt+F4"]),
+        (Target::Web, Os::Mac, de, ["⇧⌘S", "⌦", "⌃⇥", "⇧F4"]),
+        (Target::Linux, Os::Nix, None, ["Ctrl+Shift+S", "Delete", "Ctrl+Tab", "Shift+F4"]),
+    ] {
+        let mut b = Bar::new(shortcuts(), vec2(800.0, 600.0));
+        b.ctx.set_os(os);
+        b.target = target;
+        b.key_names = names;
+        b.click("Edit");
+        for (label, text) in ["Save As…", "Delete", "Next Tab", "Tools Panel"].into_iter().zip(shown) {
+            assert_eq!(b.node(label).and_then(|n| n.keyboard_shortcut()), Some(text), "{label}: {target:?} on {os:?}");
+        }
+    }
+}
+
