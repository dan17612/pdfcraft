[
  { "tool": "doc_create", "args": { "from": "blank", "pages": 1, "width": 300, "height": 200 } },
  { "tool": "form_add_field", "args": { "doc": 1, "page": 1, "type": "text", "rect": [20, 20, 200, 42], "name": "Betrag1" } },
  { "tool": "form_add_field", "args": { "doc": 1, "page": 1, "type": "text", "rect": [20, 60, 200, 82], "name": "Betrag2" } },
  { "tool": "form_add_field", "args": { "doc": 1, "page": 1, "type": "text", "rect": [20, 100, 200, 122], "name": "Summe" } },
  {
    "tool": "form_set_props",
    "args": {
      "doc": 1,
      "fields": ["Betrag1", "Betrag2", "Summe"],
      "format": { "type": "number", "decimals": 2, "separator": 2, "currency": " €", "currency_after": true }
    }
  },
  { "tool": "form_set_props", "args": { "doc": 1, "field": "Summe", "read_only": true, "calculate": { "op": "sum", "fields": ["Betrag1", "Betrag2"] } } },
  { "tool": "form_fill", "args": { "doc": 1, "values": { "Betrag1": "1.200", "Betrag2": "1,500" } } },
  { "tool": "form_fields", "args": { "doc": 1 } },
  { "tool": "page_render", "args": { "doc": 1, "page": 1, "dpi": 144 }, "out": "decimal-comma.png" },
  { "tool": "doc_save", "args": { "doc": 1, "path": "decimal-comma.pdf" } }
]
